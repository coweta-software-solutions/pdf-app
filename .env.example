# Copy this file to .env next to docker-compose.yml to customize the
# self-hosted container defaults.
PORT=3000
MAX_UPLOAD_MB=100
MAX_RENDER_PAGES=100
PDF_TOOLS_CPU_PERMITS=4

# Local non-Docker runs can set this when libpdfium.so is not on the system
# library path. The Docker image already bundles PDFium and sets this itself.
# PDF_TOOLS_PDFIUM_PATH=/path/to/libpdfium.so
